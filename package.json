{
  "name": "kaiky-rogis-portfolio",
  "version": "2.4.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/fix-static-lang.mjs",
    "build:pages": "next build && node scripts/fix-static-lang.mjs",
    "build:sites": "vinext build",
    "dev:sites": "vinext dev",
    "start:sites": "vinext start",
    "serve:test": "serve out -l 4173 --no-clipboard",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:links": "node scripts/check-static-links.mjs",
    "monitor": "node scripts/monitor-site.mjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "capture:qa": "npm run build && node scripts/capture-qa.mjs",
    "check:images": "node scripts/check-image-budget.mjs",
    "quality": "npm run format:check && npm run typecheck && npm run lint && npm run check:images && npm run build && npm run check:links"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.27.0",
    "motion": "^12.43.0",
    "next": "^16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.54.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.12",
    "prettier": "^3.8.2",
    "react-server-dom-webpack": "19.2.6",
    "serve": "^14.2.4",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
